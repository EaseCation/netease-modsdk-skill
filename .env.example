# 路径相对于本 skill 仓库根目录；可以换成已有完整 Wiki 的绝对路径。
MODSDK_WIKI_ROOT=.data/wiki
MODSDK_WIKI_REPOSITORY=https://github.com/EaseCation/netease-modsdk-wiki.git
MODSDK_WIKI_REF=main

# 使用时检查，单位小时；0 禁用自动检查，仍可手动 --check-updates。
MODSDK_UPDATE_CHECK_HOURS=24
# 单次网络尝试总超时（秒）；Git/HTTP 默认各一次直连，可选一次代理。
MODSDK_NETWORK_TIMEOUT=30
# 仅配置你信任的公开下载代理；拼接方式为 前缀 + 完整 GitHub URL。
# MODSDK_GITHUB_PROXY_PREFIX=https://your-trusted-proxy.example/
